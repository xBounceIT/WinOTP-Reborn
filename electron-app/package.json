{
  "name": "winotp-electron",
  "version": "2.0.0",
  "private": true,
  "description": "Electron migration shell for WinOTP",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs --dev\"",
    "build": "npm run typecheck && vite build",
    "test": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src vite.config.ts",
    "format": "oxfmt --write src vite.config.ts",
    "format:check": "oxfmt --check src vite.config.ts",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wait-on": "^8.0.3"
  }
}
