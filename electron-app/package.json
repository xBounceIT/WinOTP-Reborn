{
  "name": "winotp-electron",
  "version": "2.1.0",
  "private": true,
  "description": "Electron desktop app for WinOTP",
  "author": "xBounceIT",
  "license": "MIT",
  "homepage": "https://github.com/xBounceIT/WinOTP-Reborn",
  "desktopName": "WinOTP",
  "main": "electron-dist/electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:core && npm run build:electron && node scripts/dev.ts",
    "build": "npm run typecheck && vite build",
    "test": "npm run build:electron && node --test electron-dist/electron/*.test.cjs electron-dist/test/*.test.cjs test/*.test.ts",
    "test:electron": "npm run build:electron && node --test electron-dist/electron/*.test.cjs electron-dist/test/*.test.cjs",
    "pretest": "npm run build:core",
    "pretest:electron": "npm run build:core",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:electron && npm run typecheck:tooling",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "lint": "oxlint src electron scripts test vite.config.ts",
    "format": "oxfmt --write src electron scripts test vite.config.ts",
    "format:check": "oxfmt --check src electron scripts test vite.config.ts",
    "build:electron": "node scripts/build-electron.ts",
    "build:updater": "node scripts/build-updater.ts",
    "build:core": "node scripts/build-updater.ts --core-only",
    "prepackage": "npm run build:updater && npm run build:electron",
    "package": "electron-builder --publish never",
    "preview": "vite preview",
    "electron": "npm run build:core && npm run build:electron && electron ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.28.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.xbounceit.winotp",
    "productName": "WinOTP",
    "artifactName": "WinOTP-${version}-${os}-${arch}-setup.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*.cjs",
      "!electron-dist/**/*.test.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "updater",
        "filter": ["winotp-updater*", "winotp-core*", "winotp-browser-bridge*"]
      }
    ],
    "win": {
      "icon": "public/app.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "guid": "9C96A88A-8F18-4B57-9F59-AB4E2A8760D1",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "WinOTP"
    },
    "linux": {
      "category": "Utility",
      "icon": "public/app.png",
      "maintainer": "xBounceIT <xBounceIT@users.noreply.github.com>",
      "vendor": "xBounceIT",
      "publish": {
        "provider": "github",
        "owner": "xBounceIT",
        "repo": "WinOTP-Reborn"
      },
      "syncDesktopName": true,
      "target": ["AppImage", "deb", "rpm"]
    },
    "deb": {
      "afterRemove": "build/linux-after-remove.sh"
    },
    "rpm": {
      "afterRemove": "build/linux-after-remove.sh"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "public/app.png",
      "target": "dmg"
    }
  }
}
