{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "electron-dist",
    "rootDir": ".",
    "noEmit": false,
    "noEmitOnError": true,
    "noCheck": true,
    "declaration": false,
    "sourceMap": true,
    "strict": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "types": ["node", "electron"]
  },
  "include": ["electron/**/*.cts", "test/*.test.cts"]
}
